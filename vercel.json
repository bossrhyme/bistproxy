{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'; frame-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;"
        }
      ]
    },
    {
      "source": "/(deepfin|analiz/prf|profil/profil)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type",  "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(|index\\.html|screener|analiz/|analiz/index\\.html|analiz/profil\\.html|analiz/profile\\.html|profil|profil/|profil/index\\.html|admin|admin/|admin/index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/screener",
      "destination": "/"
    },
    {
      "source": "/api/stats",
      "destination": "/api/user.js"
    },
    {
      "source": "/api/scan",
      "destination": "/api/scan.js"
    },
    {
      "source": "/api/quote",
      "destination": "/api/quote.js"
    },
    {
      "source": "/api/rates",
      "destination": "/api/rates.js"
    },
    {
      "source": "/analiz",
      "destination": "/analiz/index.html"
    },
    {
      "source": "/analiz/",
      "destination": "/analiz/index.html"
    },
    {
      "source": "/analiz/profil",
      "destination": "/analiz/profil.html"
    },
    {
      "source": "/analiz/profil/",
      "destination": "/analiz/profil.html"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/fundamentals",
      "destination": "/api/fundamentals.js"
    },
    {
      "source": "/api/fon-scan",
      "destination": "/api/fon-scan.js"
    },
    {
      "source": "/api/kripto-scan",
      "destination": "/api/kripto-scan.js"
    },
    {
      "source": "/api/bist-scan",
      "destination": "/api/bist-scan.js"
    },
    {
      "source": "/api/bist-quote",
      "destination": "/api/bist-quote.js"
    },
    { "source": "/api/symbol-list",   "destination": "/api/symbols.js" },
    { "source": "/api/symbol-search", "destination": "/api/symbols.js" },
    { "source": "/api/auth/register",           "destination": "/api/user.js" },
    { "source": "/api/auth/login",              "destination": "/api/user.js" },
    { "source": "/api/auth/me",                 "destination": "/api/user.js" },
    { "source": "/api/auth/logout",             "destination": "/api/user.js" },
    { "source": "/api/auth/change-password",    "destination": "/api/user.js" },
    { "source": "/api/auth/update-profile",     "destination": "/api/user.js" },
    { "source": "/api/auth/daily-checkin",      "destination": "/api/user.js" },
    { "source": "/api/auth/set-investor-type",  "destination": "/api/user.js" },
    { "source": "/api/portfolio/item",        "destination": "/api/user.js" },
    { "source": "/api/portfolio",             "destination": "/api/user.js" },
    { "source": "/api/watchlists/:path*",  "destination": "/api/user.js" },
    { "source": "/api/watchlists",         "destination": "/api/user.js" },
    { "source": "/api/track",              "destination": "/api/user.js" },
    { "source": "/api/report",             "destination": "/api/user.js" },
    { "source": "/api/admin/users",        "destination": "/api/user.js" },
    { "source": "/api/admin/bans",         "destination": "/api/user.js" },
    { "source": "/api/admin/user-detail",  "destination": "/api/user.js" },
    { "source": "/profil",            "destination": "/profil/index.html" },
    { "source": "/profil/",           "destination": "/profil/index.html" },
    { "source": "/admin",             "destination": "/admin/index.html" },
    { "source": "/admin/",            "destination": "/admin/index.html" }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 25
    },
    "api/verify.js": {
      "maxDuration": 10
    },
    "api/fundamentals.js": {
      "maxDuration": 15
    },
    "api/fon-scan.js": {
      "maxDuration": 45
    },
    "api/kripto-scan.js": {
      "maxDuration": 20
    },
    "api/bist-scan.js": {
      "maxDuration": 15
    },
    "api/bist-quote.js": {
      "maxDuration": 10
    },
    "api/symbols.js": { "maxDuration": 15 },
    "api/user.js": { "maxDuration": 10 }
  }
}